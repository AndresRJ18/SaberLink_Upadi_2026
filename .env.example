# Copy to .env on the VPS and fill in the real values before `docker compose up`.

# Public URL/IP the browser will use to reach the backend API, baked into the
# frontend's JS bundle at build time (Vite env vars are compile-time, not
# runtime — this MUST be set correctly before `docker compose build`).
VITE_API_BASE=http://YOUR_VPS_IP:8000

# Comma-separated list of origins allowed to call the API — the frontend's
# real URL(s). Local dev origins (localhost:5173) are always allowed on top
# of this, no need to repeat them here.
CORS_ORIGINS=http://YOUR_VPS_IP
