# Copia este archivo a backend/.env (gitignorado) y completá los valores reales.
# Nunca se commitea — ver .gitignore.

# API key de Bedrock (larga duración, ver consola de AWS Bedrock → API keys).
# Ojo: es una variable especial, NO es AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
AWS_BEARER_TOKEN_BEDROCK=

AWS_REGION=us-east-1

# Model ID exacto (Nova 2 Lite, prefijo us. obligatorio para la región de EE.UU.).
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Solo para producción (docker-compose / Dokploy) — en desarrollo local no hace falta.
# CORS_ORIGINS=
